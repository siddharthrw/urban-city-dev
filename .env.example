# Copy this file to .env and edit. .env is gitignored; never commit it.

# --- Data -------------------------------------------------------------------
# All data (downloads, layers, tiles, documents, catalog) lives here, outside the repo.
# To move to a bigger disk or another machine: copy this folder, change this line.
DATA_DIR=D:\citydata

# --- LLM (used from M2 onwards) --------------------------------------------
# ollama = local, nothing leaves this machine (default)
# nim    = NVIDIA NIM, prompt text is sent to an external service
LLM_PROVIDER=ollama

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
# gpt-oss-20b is a reasoning model; small budgets truncate mid-thought and return nothing.
NVIDIA_MAX_TOKENS=4096

# --- Server -----------------------------------------------------------------
API_PORT=8000
